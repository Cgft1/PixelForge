{
  "name": "pixelforge-desktop",
  "version": "3.7.0",
  "description": "PixelForge 3.7 desktop editor",
  "main": "main.js",
  "author": "PixelForge",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pixelforge.desktop",
    "productName": "PixelForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "PixelForge.html",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "PixelForge-${version}-Windows.exe"
    }
  }
}
